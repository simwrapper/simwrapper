{
  "folders": [
    {
      "name": "SimWrapper",
      "path": ".",
      "settings": {
        "python.languageServer": "None",
        "python.testing.pytestEnabled": false,
        "python.testing.unittestEnabled": false,
        "python.terminal.activateEnvironment": false
      }
    },
    {
      "name": "WASM",
      "path": "./wasm/",
      "settings": {
        "python.languageServer": "None",
        "python.testing.pytestEnabled": false,
        "python.testing.unittestEnabled": false,
        "python.terminal.activateEnvironment": false
      }
    },
    {
      "name": "Python",
      "path": "./python/",
      "settings": {
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
          }
        },
        // uv-managed venv created by `uv sync` in ./python
        // Windows: ${workspaceFolder}/.venv/Scripts/python.exe
        // macOS/Linux: ${workspaceFolder}/.venv/bin/python
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
        "python.languageServer": "Pylance",
        "python.terminal.activateEnvironment": true,
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python.testing.pytestArgs": ["tests"],
        "python.analysis.extraPaths": ["${workspaceFolder}"],
        "python.analysis.typeCheckingMode": "off",
        "python.analysis.exclude": ["**/.venv/**"]
      }
    },
    {
      "name": "Docs",
      "path": "./docs/",
      "settings": {
        "python.languageServer": "None",
        "python.testing.pytestEnabled": false,
        "python.testing.unittestEnabled": false,
        "python.terminal.activateEnvironment": false
      }
    }
  ],
  "settings": {
    // Rust-specific settings
    "[rust]": {
      "editor.defaultFormatter": "rust-lang.rust-analyzer",
      "editor.formatOnSave": true
    },
    "rust-analyzer.cargo.allFeatures": true,
    "rust-analyzer.procMacro.enable": true,

    // Node-specific settings
    "[javascript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "javascript.validate.enable": true,
    "typescript.validate.enable": true,
    "editor.formatOnSave": true,

    // Python is configured per-folder, only for ./python (see folders[2].settings)
    "python.createEnvironment.trigger": "off",

    // Docs (Docusaurus site in ./docs/website, markdown in ./docs/docs)
    "[markdown]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.wordWrap": "on",
      "editor.quickSuggestions": {
        "other": "on"
      }
    },
    "files.watcherExclude": {
      "**/python/.venv/**": true,
      "**/docs/website/build/**": true,
      "**/docs/website/.docusaurus/**": true
    },
    "search.exclude": {
      "**/python/.venv": true,
      "**/docs/website/build": true,
      "**/docs/website/node_modules": true
    },
    "go.toolsEnvVars": {
      "GOOS": "js",
      "GOARCH": "wasm",
      "GOROOT": "/Users/billy/Library/Caches/tinygo/goroot-ba4a9a47e6136854fcbeeeddca387447b4cd9b238edb51ad8d17a915d1a97776",
      "GOFLAGS": "-tags=tinygo.wasm,tinygo,purego,osusergo,math_big_pure_go,gc.precise,scheduler.asyncify,serial.none"
    }
  },
  "extensions": {
    "recommendations": [
      "rust-lang.rust-analyzer",
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "ms-python.python",
      "ms-python.debugpy",
      "ms-python.vscode-pylance",
      "charliermarsh.ruff",
      "tamasfe.even-better-toml"
    ]
  }
}
